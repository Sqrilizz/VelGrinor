# Microsoft OAuth device-code flow (required for login)
VELGRINOR_MS_CLIENT_ID=your-client-id
VELGRINOR_MS_CLIENT_SECRET=your-client-secret

# Optional: enable CurseForge search and downloads
VELGRINOR_CURSEFORGE_API_KEY=your-api-key

# Optional: override data directory
# VELGRINOR_HOME=/path/to/.velgrinor
